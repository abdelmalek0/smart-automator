# LLM Provider: groq, google, openrouter, ollama, or ollama-cloud
LLM_PROVIDER=groq

# Groq Configuration
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini Configuration
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.5-flash

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Ollama Cloud
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_CLOUD_MODEL=gemma4:31b-cloud
OLLAMA_CLOUD_API_KEY=

# Browser Configuration
HEADLESS=false
HOME_PAGE_URL=about:blank
VIEWPORT_WIDTH=1280
VIEWPORT_HEIGHT=1100
# Persistent Chrome profile directory (cookies, history). Leave empty to use
# ~/.local/share/smart-automator-chrome when isolated profile is off.
CHROME_USER_DATA=
# Named Chrome profile within CHROME_USER_DATA (e.g. Default, Profile 1).
# Leave empty for app default or custom user-data-dir paths.
CHROME_PROFILE_DIRECTORY=
# Attach to an existing Chrome with remote debugging instead of launching one.
# CDP_URL=ws://127.0.0.1:9222
# Default isolated (throwaway) browser per run — off keeps session on disk.
QA_FRESH_PROFILE=true

# Agent Configuration
MAX_STEPS=100
PLANNING_INTERVAL=3
MAX_ACTIONS_PER_STEP=10
MAX_FAILURES=3
MAX_INPUT_TOKENS=128000

# URL firewall (comma-separated domains, empty = allow all)
ALLOWED_URLS=
DENIED_URLS=

# Logging
LOG_LEVEL=INFO
# LOG_LEVEL=DEBUG  # agent prompts/outputs + uvicorn detail
# LOG_DIR=   # optional; default data/logs

# Database (SQLite by default)
# DATABASE_URL=sqlite:////absolute/path/to/smart_automator.db
# DATABASE_FILE=   # optional; default data/smart_automator.db
